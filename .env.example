# Скопируй в .env: cp .env.example .env

APP_ENV=dev
LOG_LEVEL=INFO

# Postgres из docker-compose. Порт 5433, чтобы не конфликтовать с локальным Postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://mailpulse:mailpulse@localhost:5433/mailpulse

# Fernet-ключ для паролей приложений и refresh-токенов: make secret-key
SECRETS_KEY=

# LLM. Anthropic SDK читает ключ из окружения сам
ANTHROPIC_API_KEY=

# Трейсинг LangSmith. LangGraph и langsmith читают эти переменные сами.
# Включи true, когда добавишь LANGSMITH_API_KEY
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mailpulse
# Аккаунт в EU-регионе (eu.smith.langchain.com): иначе ключ получит 403
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Telegram-бот от @BotFather
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (туннель cloudflared или деплой).
# Без него /start показывает текстовую инструкцию вместо кнопки «Подключить почту»
MINIAPP_URL=

# Microsoft 365: регистрация приложения в Entra ID (см. scripts/check_microsoft_imap.py)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=organizations
